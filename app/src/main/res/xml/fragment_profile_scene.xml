<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/end"
        motion:constraintSetStart="@id/start"
        motion:duration="400">
       <KeyFrameSet>
       </KeyFrameSet>
        <OnSwipe motion:touchAnchorId="@+id/fragmentContainer" />
    </Transition>

    <ConstraintSet android:id="@+id/start">
    </ConstraintSet>

    <ConstraintSet android:id="@+id/end">
        <Constraint
            android:id="@+id/bannerImage"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="1px"
            android:alpha="0.0"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintBottom_toTopOf="parent" />
        <Constraint
            android:id="@+id/someButtonsLayout"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="match_parent"
            android:layout_height="1px"
            motion:layout_constraintTop_toBottomOf="@id/avatarZoneBackgroundView"
            motion:layout_constraintStart_toStartOf="parent"
            android:alpha="0.0"
            android:layout_marginTop="0dp" />
        <Constraint
            android:id="@+id/avatarZoneBackgroundView"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintStart_toEndOf="@id/avatarImage"
            android:layout_width="0dp"
            android:layout_height="70dp"
            motion:layout_constraintTop_toBottomOf="@id/bannerImage" />
        <Constraint
            android:id="@+id/userAboutText"
            motion:layout_constraintEnd_toEndOf="parent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            motion:layout_constraintStart_toEndOf="@id/avatarImage"
            motion:layout_constraintTop_toBottomOf="@id/usernameText"
            android:alpha="0.0" />
        <Constraint
            android:id="@+id/avatarImage"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toBottomOf="@id/avatarZoneBackgroundView"
            motion:layout_constraintTop_toTopOf="@id/avatarZoneBackgroundView"
            motion:layout_constraintStart_toStartOf="parent" />
    </ConstraintSet>
</MotionScene>